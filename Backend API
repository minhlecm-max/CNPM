db_config = {
    "host": "localhost",
    "user": "apiuser",
    "password": "123456",
    "database": "restaurant_menu",
}

# ================= MODELS =================
class OrderItem(BaseModel):
    food: str
    quantity: int
    price: int | None = 0

class OrderIn(BaseModel):
    customer: str = "Khách lẻ"
    table: int
    cart: List[OrderItem]

# ================= API =================
@app.post("/orders")
def create_order(order: OrderIn):
    conn = mysql.connector.connect(**db_config)
    cursor = conn.cursor()

    cart_json = json.dumps([i.dict() for i in order.cart], ensure_ascii=False)

    cursor.execute(
        """
        INSERT INTO orders (customer, table_number, order_data, status, created_at)
        VALUES (%s,%s,%s,%s,%s)
        """,
        (order.customer, order.table, cart_json, "new", datetime.now()),
    )

    conn.commit()
    cursor.close()
    conn.close()
    return {"message": "ok"}

@app.get("/orders")
def get_orders():
    conn = mysql.connector.connect(**db_config)
    cursor = conn.cursor(dictionary=True)

    cursor.execute("SELECT * FROM orders ORDER BY created_at DESC")
    rows = cursor.fetchall()

    for r in rows:
        try:
            r["order_data"] = json.loads(r["order_data"])
        except:
            r["order_data"] = []

    cursor.close()
    conn.close()
    return rows

@app.put("/orders/{order_id}/{status}")
def update_status(order_id: int, status: str):
    conn = mysql.connector.connect(**db_config)
    cursor = conn.cursor()
    cursor.execute("UPDATE orders SET status=%s WHERE id=%s", (status, order_id))
    conn.commit()
    cursor.close()
    conn.close()
    return {"message": "updated"}

@app.delete("/orders/{order_id}")
def delete_order(order_id: int):
    conn = mysql.connector.connect(**db_config)
    cursor = conn.cursor()
    cursor.execute("DELETE FROM orders WHERE id=%s", (order_id,))
    conn.commit()
    cursor.close()
    conn.close()
    return {"message": "deleted"}

